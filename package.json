{
  "name": "wheelhouse-bike-repair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Wheelhouse Bike Repair responsive website",
  "scripts": {
    "lint:html": "htmlhint index.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint \"js/**/*.js\"",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "format:check": "prettier --check \"*.html\" \"css/**/*.css\" \"js/**/*.js\"",
    "format": "prettier --write \"*.html\" \"css/**/*.css\" \"js/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0"
  }
}
